<?xml version="1.0" encoding="UTF-8" ?>

<config xmlns="http://thelia.net/schema/dic/config"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://thelia.net/schema/dic/config http://thelia.net/schema/dic/config/thelia-1.0.xsd">

    <!-- Keep the historical loop names as aliases. Thelia 3 auto-registers the
         loop, form, hook and event-listener services through configureServices(). -->
    <loops>
        <loop name="frontview" class="View\Loop\FrontView" />
        <loop name="frontfiles" class="View\Loop\Frontfiles" />
    </loops>
</config>
